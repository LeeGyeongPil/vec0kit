# vec0kit 은 키 없이 동작한다. 아래 값은 `migrate --reembed openai` 를 쓸 때만 필요하다.
# vec0kit works without any key. These are only needed for `migrate --reembed openai`.

# Output language: en | ko  (--lang wins, then this, then LC_ALL / LC_MESSAGES / LANG)
VEC0KIT_LANG=

# Any OpenAI-compatible /embeddings endpoint. Local Ollama needs no key:
VEC0KIT_EMBED_URL=http://localhost:11434/v1
VEC0KIT_EMBED_MODEL=nomic-embed-text

# Optional. Sent as "Authorization: Bearer <key>" when set.
VEC0KIT_EMBED_API_KEY=
